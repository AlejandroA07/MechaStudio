{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mechastudio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "vars": { "ENVIRONMENT": "development" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mechastudio",
      "database_id": "replace-after-provisioning",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mechastudio-media" }],
  "ratelimits": [{ "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
}
